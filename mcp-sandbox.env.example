# Copy to mcp-sandbox.env (same directory, chmod 600) and fill in.
# Loaded by systemd via EnvironmentFile=.

# Public URL prefix used to build download links in present_file.
MCP_PUBLIC_BASE=https://your.host.example:8443

# HMAC key for those links. Generate with: openssl rand -hex 32
# Separate from the bearer token on purpose: these end up in URLs.
MCP_SIGN_KEY=

# --- optional overrides -------------------------------------------------
# SANDBOX_IDLE=300          # seconds before an idle container is recycled
# SANDBOX_MAX=2             # concurrent containers; extra ones evict the LRU
# SANDBOX_MAX_TIMEOUT=900   # ceiling on the model's timeout_seconds
# SANDBOX_MIN_FREE=2147483648
# SANDBOX_LINK_TTL=3600
# SANDBOX_IMAGE_MAX=1572864
# SANDBOX_INLINE_MAX=49152
# SANDBOX_IMAGE=localhost/sandbox-base:latest
# SANDBOX_HOST=127.0.0.1
# SANDBOX_PORT=8000
