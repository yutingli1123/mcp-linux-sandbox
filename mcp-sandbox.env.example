# Copy to mcp-sandbox.env (same directory, chmod 600) and fill in.
# Loaded by systemd via EnvironmentFile=.

# Public URL prefix used to build download links in present_file.
MCP_PUBLIC_BASE=https://your.host.example:8443

# HMAC key for those links. Generate with: openssl rand -hex 32
# Separate from the bearer token on purpose: these end up in URLs.
MCP_SIGN_KEY=

# --- optional overrides -------------------------------------------------
# Uncomment a line to override its default, and leave the setting alone on its
# line: systemd only treats # as a comment at the start of a line, so anything
# written after a value becomes part of that value.

# seconds before an idle container is recycled
# SANDBOX_IDLE=300
# concurrent containers; extra ones evict the LRU
# SANDBOX_MAX=2
# ceiling on the model's timeout_seconds, in seconds
# SANDBOX_MAX_TIMEOUT=900
# refuse to start a sandbox below this many bytes free
# SANDBOX_MIN_FREE=2147483648
# how long a download link stays valid, in seconds
# SANDBOX_LINK_TTL=600
# largest image that gets attached, in bytes
# SANDBOX_IMAGE_MAX=1572864
# base image for sandbox containers
# SANDBOX_IMAGE=localhost/sandbox-base:latest
# address and port the server binds to
# SANDBOX_HOST=127.0.0.1
# SANDBOX_PORT=8000
